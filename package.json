{
  "name": "rpgle_library",
  "version": "1.1.0",
  "description": "An RPG IV (RPGLE) and DDS parser/interpreter for Node.js. No required dependencies; DISK files need the optional better-sqlite3.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dds": "./src/dds.js",
    "./rpgle": "./src/rpgle.js",
    "./expr": "./src/expr.js",
    "./interpreter": "./src/interpreter.js"
  },
  "scripts": {
    "test": "node --test",
    "example": "node examples/quick-math.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "rpg",
    "rpgle",
    "rpg-iv",
    "dds",
    "ibm-i",
    "as400",
    "iseries",
    "5250",
    "ile",
    "mainframe",
    "ibm"
  ],
  "author": "Britley Wren Hoff",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wren-creator/rpgle_library.git"
  },
  "bugs": {
    "url": "https://github.com/wren-creator/rpgle_library/issues"
  },
  "homepage": "https://github.com/wren-creator/rpgle_library#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "src/",
    "docs/",
    "examples/",
    "programs/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
